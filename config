# macos-titlebar-style=hidden
background-opacity=0.96

font-family = FiraCode Nerd Font Mono
font-family-bold = FiraCode Nerd Font Mono Bold
#keybindings

# ctrl key for "creation" i.e open tab
# opt (alt) key for "movement" i.e move to next tab

# create splits
keybind = ctrl+a>l=new_split:right
keybind = ctrl+a>j=new_split:down
keybind = ctrl+a>k=new_split:up
keybind = ctrl+a>h=new_split:left

# move splits
keybind = ctrl+a>shift+l=goto_split:right
keybind = ctrl+a>shift+j=goto_split:bottom
keybind = ctrl+a>shift+k=goto_split:top
keybind = ctrl+a>shift+b=goto_split:left

# create tabs
keybind = ctrl+a>ctrl+t=new_tab

# move through tabs
keybind = ctrl+a>ctrl+h=previous_tab
keybind = ctrl+a>ctrl+l=next_tab




keybind = f2=toggle_fullscreen
keybind = f3=toggle_split_zoom