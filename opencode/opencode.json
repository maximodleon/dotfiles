{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "mcp": {
    "google stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": ""
      },
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode/kimi-k2.5",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "model": "opencode/gpt-5.2-codex",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  }
}
